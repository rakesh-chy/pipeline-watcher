# Pipeline-watcher configuration
# Copy to `.env` and edit. Empty values use the defaults from src/watcher/config.py.

# --- Database ---
WATCHER_DATABASE_URL=postgresql://watcher:watcher@localhost:5432/watcher

# --- API server ---
WATCHER_API_HOST=127.0.0.1
WATCHER_API_PORT=8080

# --- Alerts (optional) ---
# WATCHER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
WATCHER_ALERTS_ENABLED=false

# --- Scheduler ---
WATCHER_CHECK_INTERVAL_SECONDS=60

# --- Logging ---
WATCHER_LOG_LEVEL=INFO
